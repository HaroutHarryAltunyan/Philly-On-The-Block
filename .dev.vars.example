# Copy this file to .dev.vars and fill in real values for local development.
# .env* files (including .dev.vars) are gitignored — never commit keys.

# Stripe test-mode keys from https://dashboard.stripe.com/test/apikeys
STRIPE_SECRET_KEY=sk_test_xxx
# Webhook signing secret from `stripe listen --forward-to localhost:3000/api/stripe/webhook`
# (run `npx stripe listen` after adding your Stripe secret key)
STRIPE_WEBHOOK_SECRET=whsec_xxx
